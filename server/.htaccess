# HPX-Core の「送信先のトークン」(Authorization: Bearer ...) を PHP (receive.php) に渡す。
# さくらのレンタルサーバーでは、これが無いとトークン欄の方法では 401 になることがある (URL に ?k= を付ける方法はこれが無くても動く)。
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
